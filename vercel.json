{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "echo Static site ready",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "oyeola-web.vercel.app"
        }
      ],
      "destination": "https://www.oyeolaonline.com/:path*",
      "permanent": true
    },
    {
      "source": "/website-check",
      "destination": "/websites",
      "permanent": true
    },
    {
      "source": "/website-check.html",
      "destination": "/websites",
      "permanent": true
    },
    {
      "source": "/operations-check",
      "destination": "/operations",
      "permanent": true
    },
    {
      "source": "/operations-check.html",
      "destination": "/operations",
      "permanent": true
    },
    {
      "source": "/workflow-check",
      "destination": "/operations",
      "permanent": true
    },
    {
      "source": "/workflow-check.html",
      "destination": "/operations",
      "permanent": true
    },
    {
      "source": "/demos",
      "destination": "/showroom",
      "permanent": true
    },
    {
      "source": "/demos.html",
      "destination": "/showroom",
      "permanent": true
    },
